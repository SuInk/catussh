"Only config and .conf files inside the selected SSH folder can be included." = "Include 仅支持所选 SSH 文件夹内名为 config 或以 .conf 结尾的文件。";
"Invalid or oversized OpenSSH configuration in %@." = "%@ 中的 OpenSSH 配置格式无效或文件过大。";
"%@, line %lld" = "%1$@ 的第 %2$lld 行";
"Invalid OpenSSH directive in %@." = "%@中有无效的 OpenSSH 指令。";
